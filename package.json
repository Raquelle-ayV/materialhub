{
  "name": "rematerial",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch backend/src/server.mjs",
    "dev:client": "vite --host localhost",
    "build": "tsc --noEmit && vite build",
    "start": "node backend/src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@zxing/browser": "^0.1.5",
    "canvas-confetti": "1.9.3",
    "express": "^5.1.0",
    "i18next": "^25.0.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.5.0",
    "react-router-dom": "^7.6.0",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/canvas-confetti": "1.9.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
